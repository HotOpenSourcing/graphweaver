{
  "name": "@exogee/graphweaver-rest",
  "version": "2.24.1",
  "description": "RESTful backend adapter for @exogee/graphweaver",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/exogee-technology/graphweaver.git"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node init && npm run build:js && npm run build:types",
    "build:js": "node init && node build.js",
    "build:types": "node init && tsc --emitDeclarationOnly",
    "package:pack": "pnpm pack",
    "prettier": "prettier --write src/**/*.ts",
    "codegen": "graphql-codegen --config ./codegen.yml",
    "test": "vitest",
    "version": "npm version --no-git-tag-version"
  },
  "main": "lib/index.js",
  "source": "src/index.ts",
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@exogee/graphweaver": "workspace:*",
    "@exogee/logger": "workspace:*",
    "dataloader": "2.2.3",
    "escape-string-regexp": "4.0.0",
    "got-cjs": "12.5.4"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "esbuild": "0.28.1",
    "glob": "13.0.6",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.0"
  },
  "keywords": [
    "graphql",
    "gql",
    "headless",
    "cms",
    "REST",
    "federation"
  ]
}
